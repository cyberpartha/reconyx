# RECONYX Environment Variables Template
# Copy this file to .env and populate with your actual API keys.
# NEVER commit your .env file to version control.

# ──────────────────────────────────────────────────────────
# VirusTotal API Key (free tier available at virustotal.com)
# ──────────────────────────────────────────────────────────
RECONYX_VT_KEY=
# VT_API_KEY=        # Alternative variable name

# ──────────────────────────────────────────────────────────
# SecurityTrails API Key (free tier at securitytrails.com)
# ──────────────────────────────────────────────────────────
RECONYX_ST_KEY=
# ST_API_KEY=        # Alternative variable name

# ──────────────────────────────────────────────────────────
# Source Toggles (optional — 1=enable, 0=disable)
# ──────────────────────────────────────────────────────────
# RECONYX_ENABLE_SUBFINDER=1
# RECONYX_ENABLE_AMASS=1
# RECONYX_ENABLE_WAYBACK=1
# RECONYX_ENABLE_COMMONCRAWL=1
